%% 生态链场景智能体化 · 类图（架构设计 v1.1 提取）
classDiagram
    class ReplayPackage {
        +str replay_id
        +str schema_version
        +str scene
        +str kind
        +str title
        +list~ReplayAgent~ agents
        +list~ReplayStep~ steps
        +ReplayConclusion conclusion
        +str source
    }
    class ReplayAgent {
        +str domain
        +str abbr
        +str name
        +str role
    }
    class ReplayStep {
        +int step
        +str thought
        +str tool
        +dict args
        +str summary
        +bool ok
    }
    class ReplayConclusion {
        +str answer
        +list~str~ data_used
        +bool needs_hitl
        +str hitl_title
        +str hitl_slot
        +list~str~ data_gaps
    }
    class AgentReplayPayload {
        +str scenario_key
        +ReplayTrigger trigger
        +DagSpec dag
        +dict node_steps
        +list~HitlSlot~ hitl_slots
    }
    class ReplayTrigger {
        +str event_id
        +str type
        +str object_ref
        +str summary
    }
    class DagSpec {
        +list~DagNode~ nodes
        +list~DagEdge~ edges
    }
    class DagNode {
        +str id
        +str label
        +str agent
        +str kind
        +str condition
        +str slot
    }
    class DagEdge {
        +str from
        +str to
    }
    class HitlSlot {
        +str slot
        +str title
        +list~str~ approver_roles
    }
    class CaseSearchReplayPayload {
        +str query
        +list~TraceStep~ trace
        +list~CaseHit~ hits
        +list~str~ filter_explain
        +int hidden_count
        +dict ontology_gain
        +list restricted
    }
    class TraceStep {
        +int step
        +str title
        +str detail
        +list~str~ items
    }
    class CaseHit {
        +str case_id
        +str title
        +str root_cause
        +str dept
        +bool redacted
        +float score
        +str reason
    }
    class KbqaReplayPayload {
        +str question
        +str answer
        +str channel
        +str faq_id
        +list sources
        +bool degraded
        +float confidence
    }
    class SeedTaskContext {
        +str slot
        +str scene
        +str origin
        +str demo_seed_id
        +str complaint_id
        +str lot_id
        +list actions
    }
    class AgentPanelOpts {
        +str title
        +list~ReplayAgent~ agents
        +DagSpec dag
        +list~ReplayStep~ steps
        +dict node_steps
        +ReplayConclusion conclusion
        +str source
        +dict hitl_task
    }
    class KnowledgeCardOpts {
        +str title
        +str svg
        +list nodes
        +str caption
    }
    class SceneKit {
        +agentPanel(opts) str
        +knowledgeCard(opts) str
        +replay(replayId) Promise
    }

    ReplayPackage *-- ReplayAgent
    ReplayPackage *-- ReplayStep
    ReplayPackage *-- ReplayConclusion
    ReplayPackage <|-- AgentReplayPayload
    ReplayPackage <|-- CaseSearchReplayPayload
    ReplayPackage <|-- KbqaReplayPayload
    AgentReplayPayload *-- ReplayTrigger
    AgentReplayPayload *-- DagSpec
    AgentReplayPayload *-- HitlSlot
    DagSpec *-- DagNode
    DagSpec *-- DagEdge
    CaseSearchReplayPayload *-- TraceStep
    CaseSearchReplayPayload *-- CaseHit
    AgentPanelOpts ..> ReplayPackage : 由 replay() 返回值装配
    AgentPanelOpts *-- DagSpec
    AgentPanelOpts *-- ReplayConclusion
    SceneKit ..> AgentPanelOpts
    SceneKit ..> KnowledgeCardOpts
