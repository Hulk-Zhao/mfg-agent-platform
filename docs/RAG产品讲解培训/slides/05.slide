<Slide style={{ width: 1280, height: 720, padding: 0, background: '#FFFFFF', fontFamily: '"Noto Sans SC","Source Han Sans SC","PingFang SC","Microsoft YaHei",sans-serif' }}>
    <Box style={{ height: 120, padding: '34px 64px 0', flexDirection: 'column' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3 }}>一个平台，把异常响应收敛成一条可审计链路</Text>
        <Text style={{ fontSize: 16, color: '#64748B', marginTop: 8 }}>产品一页看懂：先看它是什么，再看它由什么组成</Text>
    </Box>
    <Box style={{ height: 540, padding: '20px 64px 0', flexDirection: 'row', gap: 40 }}>
        <Box style={{ width: 660, flexDirection: 'column' }}>
            <Box style={{ width: 660, height: 371, borderRadius: 12, border: '1px solid #BFDBFE', overflow: 'hidden' }}>
                <Image src="assets/kbqa_screen.png" style={{ width: 660, height: 371, objectFit: 'cover' }} />
            </Box>
            <Box style={{ marginTop: 14, background: '#0F172A', borderRadius: 12, padding: '16px 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                <Box style={{ background: 'rgba(37,99,235,0.25)', border: '1px solid rgba(59,130,246,0.6)', borderRadius: 6, padding: '4px 10px' }}>
                    <Text style={{ fontSize: 13, color: '#93C5FD', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>真实运行界面</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#E2E8F0', lineHeight: 1.5, flex: 1 }}>企业制度问答：提问「年假怎么休」，<Text style={{ fontSize: 16, color: '#F97316', fontWeight: 'bold' }}>7ms</Text> 返回、答案带制度出处、全程 0 次 LLM 调用</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
            <Box style={{ background: '#EFF6FF', border: '1px solid #BFDBFE', borderRadius: 12, padding: '14px 18px' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E40AF' }}>制造业多智能体协同平台</Text>
                <Text style={{ fontSize: 15, color: '#475569', lineHeight: 1.5, marginTop: 4 }}>LangGraph 编排 · 人工在环会签 · Text2SQL 只读治理 · 本地增强 RAG，每一步都有事件流、SQL 溯源和权限校验</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 2, fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>核心链路 · 六步闭环</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, padding: '7px 0' }}>
                    <Box style={{ width: 24, height: 24, borderRadius: 6, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>1</Text></Box>
                    <Text style={{ fontSize: 17, color: '#0F172A', fontWeight: 'bold' }}>提问</Text>
                    <FAIcon name='chevron-right' style={{ fill: '#94A3B8', width: 14, height: 14, marginLeft: 'auto' }} />
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, padding: '7px 0' }}>
                    <Box style={{ width: 24, height: 24, borderRadius: 6, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>2</Text></Box>
                    <Text style={{ fontSize: 17, color: '#0F172A', fontWeight: 'bold' }}>路由：规则快路径 + 闭集分类</Text>
                    <FAIcon name='chevron-right' style={{ fill: '#94A3B8', width: 14, height: 14, marginLeft: 'auto' }} />
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, padding: '7px 0' }}>
                    <Box style={{ width: 24, height: 24, borderRadius: 6, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>3</Text></Box>
                    <Text style={{ fontSize: 17, color: '#0F172A', fontWeight: 'bold' }}>多域并行取证（品质 / 供应链 / 设备）</Text>
                    <FAIcon name='chevron-right' style={{ fill: '#94A3B8', width: 14, height: 14, marginLeft: 'auto' }} />
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, padding: '7px 0' }}>
                    <Box style={{ width: 24, height: 24, borderRadius: 6, background: '#2563EB', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>4</Text></Box>
                    <Text style={{ fontSize: 17, color: '#0F172A', fontWeight: 'bold' }}>生成工单（状态机 + SLA）</Text>
                    <FAIcon name='chevron-right' style={{ fill: '#94A3B8', width: 14, height: 14, marginLeft: 'auto' }} />
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, padding: '7px 0' }}>
                    <Box style={{ width: 24, height: 24, borderRadius: 6, background: '#06B6D4', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>5</Text></Box>
                    <Text style={{ fontSize: 17, color: '#0F172A', fontWeight: 'bold' }}>人工会签（一人一签，幂等）</Text>
                    <FAIcon name='chevron-right' style={{ fill: '#94A3B8', width: 14, height: 14, marginLeft: 'auto' }} />
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, padding: '7px 0' }}>
                    <Box style={{ width: 24, height: 24, borderRadius: 6, background: '#06B6D4', justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 12, color: '#FFFFFF', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>6</Text></Box>
                    <Text style={{ fontSize: 17, color: '#0F172A', fontWeight: 'bold' }}>对客报告（结论可回放）</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, padding: '10px 8px', alignItems: 'center' }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2563EB', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>18</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 2 }}>智能体</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, padding: '10px 8px', alignItems: 'center' }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2563EB', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>7</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 2 }}>协同场景</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, padding: '10px 8px', alignItems: 'center' }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2563EB', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>31</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 2 }}>演示岗位</Text>
                </Box>
                <Box style={{ flex: 1, background: '#F1F5F9', borderRadius: 10, padding: '10px 8px', alignItems: 'center' }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2563EB', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>13</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 2 }}>主导航屏</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 64px', position: 'relative' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 12, height: 12, borderRadius: 3, background: '#2563EB' }} />
            <Box style={{ width: 9, height: 9, borderRadius: 5, background: '#06B6D4' }} />
            <Text style={{ fontSize: 14, color: '#94A3B8' }}>mfg-agent-platform · 独立开发实践分享</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>05 / 20</Text>
        <Box style={{ position: 'absolute', bottom: 0, left: 0, width: 1280, height: 3, background: 'linear-gradient(90deg, #2563EB 0%, #06B6D4 55%, rgba(6,182,212,0) 100%)' }} />
    </Box>
</Slide>
