                <Box style={{ height: 1, background: '#E2E8F0' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 22 }}>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#2563EB', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace', width: 52 }}>03</Text>
