                <Box style={{ width: 64, height: 5, background: '#06B6D4', borderRadius: 3, margin: '22px 0 20px' }} />
                <Text style={{ fontSize: 17, color: '#DBEAFE', lineHeight: 1.7 }}>三个问题，一条主线：<br />为什么做、RAG 怎么搭、<br />多 Agent 什么关系。</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#93C5FD', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>20 PAGES · 3 CHAPTERS</Text>
        </Box>
        <Box style={{ flex: 1, height: 660, padding: '52px 64px 40px 56px', flexDirection: 'column' }}>
            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 22 }}>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#2563EB', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace', width: 52 }}>01</Text>
                    <Box style={{ flex: 1 }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 14 }}>
                            <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#0F172A' }}>产品初衷：为什么做这个产品</Text>
                            <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>P04–P06</Text>
                        </Box>
                        <Text style={{ fontSize: 17, color: '#475569', lineHeight: 1.6, marginTop: 8 }}>三个一线痛点怎么长成一个产品定位，以及四条验收级的设计原则。</Text>
                    </Box>
                </Box>
                <Box style={{ height: 1, background: '#E2E8F0' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 22 }}>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#2563EB', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace', width: 52 }}>02</Text>
                    <Box style={{ flex: 1 }}>
                        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 14 }}>
                            <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#0F172A' }}>RAG 模块：三层架构与搭建思路</Text>
                            <Text style={{ fontSize: 14, color: '#94A3B8', fontFamily: '"JetBrains Mono","Space Grotesk",Consolas,monospace' }}>P08–P16</Text>
                        </Box>
                        <Text style={{ fontSize: 17, color: '#475569', lineHeight: 1.6, marginTop: 8 }}>今天的主场：每层怎么实现、阈值怎么定、效果怎么量、方法怎么复刻。</Text>
                    </Box>
