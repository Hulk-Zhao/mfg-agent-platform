%% SPC 过程能力看板增量增强 · 数据结构与接口（类图）
%% 来源：docs/spc-dashboard-upgrade-design.md §4.1
%% 注意：process_stage / product_category 为本次新增列（可空，老行 NULL）
%% 本文件独立于 docs/class-diagram.mermaid（该文件属并发编辑中的其他需求，未覆盖）

classDiagram
    class SpcMeasurement {
        +int id PK
        +str characteristic
        +int subgroup_no
        +int seq
        +float value
        +float usl
        +float lsl
        +str measured_at
        +str source
        +str ingested_by
        +str ingested_at
        +str process_stage "新增·可空·MFG_STAGES"
        +str product_category "新增·可空·MFG_PRODUCT_CATEGORIES"
    }

    class QualityDefect {
        +int id PK
        +str batch_no
        +str product_model
        +str line_code
        +str defect_type
        +int defect_qty
        +int total_qty
        +str inspect_time
        +str process_stage "已有·直接列"
        +str defect_category "已有"
        +str product_category "已有·直接列"
    }

    class SpcCapability {
        +str characteristic
        +float cp
        +float cpk
        +float pp
        +float ppk
        +float sigma_within
        +float sigma_overall
        +int n_total
        +int n_subgroups
        +dict spec
        +str verdict
        +bool data_gap
        +list warnings
    }

    class SpcDashboardPayload {
        +str screen
        +str generated_at
        +bool degraded
        +str degraded_reason
        +dict window
        +list kpis
        +list capabilities
        +list pareto
        +list rankings
        +list notes
        +bool data_gap
        +dict filter
    }

    class SpcCapabilityDetail {
        +str screen
        +int level
        +str characteristic
        +float cp
        +float cpk
        +float pp
        +float ppk
        +dict spec
        +str verdict
        +str status
        +float over_rate
        +int over_num
        +int over_den
        +list daily
        +list records
        +list columns
        +dict filter
    }

    class DrillDefs {
        +dict spc_capability
        +dict spc_pareto
    }

    class SpcScope {
        +str stage_col
        +str pcat_col
    }

    SpcMeasurement --> SpcCapability : "按特性+子组聚合 → compute_capability"
    QualityDefect --> SpcDashboardPayload : "柏拉图（直接列折叠）"
    SpcMeasurement --> SpcDashboardPayload : "能力表 + 越限率（直接列折叠）"
    DrillDefs --> SpcScope : "声明 spc_scope"
    SpcScope ..> SpcMeasurement : "process_stage / product_category 精确匹配"
    SpcScope ..> QualityDefect : "process_stage / product_category 精确匹配"
    SpcCapabilityDetail ..> SpcCapability : "复用 _spc_caps_from_rows（同源）"
