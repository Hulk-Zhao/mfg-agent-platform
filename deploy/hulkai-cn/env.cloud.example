# ============================================================
# hulkai.cn 云上实例配置
# 复制为 deploy/hulkai-cn/.env 后填真实密钥
#
# 铁律：这个文件里不要出现任何 MySQL / Milvus / Redis 地址。
# 一旦填上，等于把演示实例拖回"必须有外部中间件才能跑"的形态，
# 而演示隔离自检（v2/demo/config_demo.py::assert_isolated）也会盯上这种写法。
# ============================================================

# ---- 演示标识 ----------------------------------------------------
MFG_DEMO_MODE=1
MFG_DEMO_LABEL=演示数据

# ---- 存储：留空即 SQLite，不要填 MySQL --------------------------------
# config.py: DB_URL 留空 → 回落 data/ 下的 SQLite
DB_URL=

# ---- 向量库：必须用 chroma --------------------------------------------
# 这是整套"零中间件"方案的地基。填 milvus 会立刻要求 torch + GPU + 独立服务，
# 轻量云扛不住，而且 rag_tools.py 会在那个分支 import BGE-M3 本地大模型。
VECTOR_BACKEND=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---- 缓存：演示可留空（留空即禁用，连接失败自动降级）----------------------
# 想要更快可以先不填，稳定后再加一个本地 redis 容器。
REDIS_URL=
CACHE_TTL_S=600
RATE_LIMIT_PER_MIN=60

# ---- LLM：走 DeepSeek，本机不跑模型 ------------------------------------
LLM_PROVIDER=deepseek
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-在这里填你的真实密钥
OPENAI_MODEL=deepseek-chat

# 兼容写法（二选一即可，留空的那个不影响）
DS_URL=
DS_KEY=

# ---- 本地 Ollama：云上没有，必须留空 ------------------------------------
OLLAMA_BASE_URL=
OLLAMA_MODEL=
