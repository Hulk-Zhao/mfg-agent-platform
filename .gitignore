# ---- Scratch / QA temp dirs ----
.tmp-qa/
.tmp-test/
# pytest --basetemp / e2e 临时库残留（名字不可预测，通配收编；约定见
# tests/v2/conftest.py 的 concurrent-pytest-guard docstring：跑测试带
# --basetemp，别在仓库根目录留 _pt* / tmp_* 残渣）
/_pt*/
/tmp_*/

