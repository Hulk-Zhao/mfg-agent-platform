# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/

# ---- Virtual env / tooling ----
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Secrets / local env ----
.env

# ---- Runtime data (regenerated by init_db / knowledge.seed) ----
data/*.db
data/chroma/
data/knowledge_base_assistant/

# ---- Local model weights (e.g. intent BERT, ~391MB, not redistributable) ----
models/

# ---- Logs ----
logs/*.log
logs/*.txt

# ---- Scratch / QA temp dirs ----
.tmp-qa/
.tmp-test/

# ---- Tunnel binaries + runtime logs (bin\*.exe are vendored binaries) ----
bin/cloudflared.exe
bin/cpolar.exe
logs/cloudflared.log
logs/pinggy_tunnel.log
logs/api.log
logs/public_url.txt
logs/ssh_run_output.txt
logs/*_test.log
logs/pinggy_test.log

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Local tool/editor state (never publish) ----
.playwright-cli/
.trae/
docs/screenshots/
