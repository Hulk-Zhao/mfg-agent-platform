# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=demo123
MYSQL_DB=mfg_agent

# ===== 持久化（业务读路径 / 治理写路径）=====
# 业务数据源（DataSource 契约）：留空 = 本地 SQLite（零依赖）
# 生产示例：DB_URL=mysql+pymysql://root:demo123@localhost:3307/mfg_agent
# ⚠ 端口注意：docker-compose.infra.yml 把 MySQL 映射到宿主 3307（避让本机 3306）
DB_URL=

# 治理库（工单 / 会签 / SLA / HITL 队列）——**当前只支持 SQLite**
# WorkflowEngine 直连 sqlite3，未接入 SQLAlchemy；因此它不继承 DB_URL：
# 若 DB_URL 为 MySQL，本项自动回落本地 SQLite 文件（不会把 URL 当路径）。
# 需要把治理库放到指定位置时显式指定，例如：
#   WORKFLOW_DB=sqlite:////var/lib/mfg/platform.db
# 填非 SQLite 地址会在启动时抛 WorkflowBackendError（fail-fast，不静默降级）。
WORKFLOW_DB=

# ===== 向量库 =====
# chroma（默认，本地持久化，零依赖）| milvus（需 standalone + 本地 BGE-M3 权重）
#
# 注意：下面这些是**宿主机视角**的地址。应用跑进容器后 localhost 指向容器自己，
# docker-compose.yml 会用 CONTAINER_* 系列变量覆盖为 host.docker.internal（或服务名），
# 无需在这里改。见 README「应用跑在容器里时：两套地址视角」。
VECTOR_BACKEND=chroma
MILVUS_URI=http://localhost:19531
MILVUS_EMBEDDING_MODEL=models/bge-m3
MILVUS_RERANKER_MODEL=models/bge-reranker-v2-m3

# ===== Redis 缓存（可选；留空即禁用，连接失败自动降级）=====
# docker-compose.infra.yml 的 mfg_redis → 宿主 6380
REDIS_URL=
CACHE_TTL_S=600
RATE_LIMIT_PER_MIN=60

# ===== 认证 =====
# 岗位令牌 HMAC 密钥；留空 = 进程级随机密钥（重启即失效并告警）。
# 对外演示 / 生产必须显式配置，否则等同「链接即权限」。
AUTH_SECRET=

# ===== ChromaDB =====
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ===== LLM =====
# 提供方：deepseek | ollama | openai
# 留空则自动解析：存在 DS_KEY 走 DeepSeek，否则回落 Ollama
LLM_PROVIDER=deepseek

# DeepSeek（推荐：直接复用系统环境变量 ds_url / ds_key，无需写在本文件）
# 若系统环境变量未设置，可在此处显式配置（不要把真实 key 提交到仓库）
DS_URL=https://api.deepseek.com
DS_KEY=
# 统一使用快模型；思考档位由 llm_factory 按节点分级：
# 意图路由/工具循环/报告生成 = disabled；FA 根因分析 = low（有相似案例）/ medium（无案例）
DS_MODEL_L1=deepseek-flash
DS_MODEL_L2=deepseek-flash

# 本地开发：用宿主机 Ollama；容器内：http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# 复用本机已下载的模型
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODEL_L1=qwen3.5:4b

# OpenAI 兼容接口（通用兜底，可选）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Docker 构建代理（可选，国内网络一般留空）
DOCKER_BUILD_PROXY=

# ===== 办公助手后端（会议室预订 / 订餐）=====
# demo（默认，内存种子数据，零依赖）| feishu（飞书开放平台：会议室走飞书日历）
OFFICE_BACKEND=demo

# 飞书自建应用凭据（开发者后台 → 凭据与基础信息）；OFFICE_BACKEND=feishu 时必填，
# 缺失会启动报错（业务办理不允许静默回落 demo）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 承载会议室日程的日历 ID（GET /open-apis/calendar/v4/calendars 查询）
FEISHU_CALENDAR_ID=
# 会议室层级 ID（留空 = 根层级，列出全部会议室）
FEISHU_ROOM_LEVEL_ID=
FEISHU_TZ=Asia/Shanghai
FEISHU_TIMEOUT_S=10
