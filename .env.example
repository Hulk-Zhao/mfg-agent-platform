# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=demo123
MYSQL_DB=mfg_agent

# ===== ChromaDB =====
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ===== LLM =====
# 提供方：deepseek | ollama | openai
# 留空则自动解析：存在 DS_KEY 走 DeepSeek，否则回落 Ollama
LLM_PROVIDER=deepseek

# DeepSeek（推荐：直接复用系统环境变量 ds_url / ds_key，无需写在本文件）
# 若系统环境变量未设置，可在此处显式配置（不要把真实 key 提交到仓库）
DS_URL=https://api.deepseek.com
DS_KEY=
# 统一使用快模型；非推理节点默认关闭思考（thinking=disabled），FA 分析用轻量思考
DS_MODEL_L1=deepseek-flash
DS_MODEL_L2=deepseek-flash

# 本地开发：用宿主机 Ollama；容器内：http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# 复用本机已下载的模型
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODEL_L1=qwen3.5:4b

# OpenAI 兼容接口（通用兜底，可选）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Docker 构建代理（可选，国内网络一般留空）
DOCKER_BUILD_PROXY=
