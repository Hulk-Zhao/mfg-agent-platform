# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=demo123
MYSQL_DB=mfg_agent

# ===== ChromaDB =====
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ===== LLM =====
# ollama | openai
LLM_PROVIDER=ollama
# 本地开发：用宿主机 Ollama；容器内：http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# 复用本机已下载的模型
OLLAMA_MODEL=qwen3.5:9b

# OpenAI 兼容接口（DeepSeek/智谱，可选）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Docker 构建代理（可选，国内网络一般留空）
DOCKER_BUILD_PROXY=
